// storage.rules
// Deploy with: firebase deploy --only storage

rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Maintenance photos — authenticated staff only
    match /maintenance_photos/{logId}/{photo} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 5 * 1024 * 1024   // max 5 MB per photo
        && request.resource.contentType.matches('image/.*');
    }

    // QR code images — readable by all authenticated users
    match /qr_codes/{assetCode} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null
        && request.resource.contentType == 'image/png';
    }
  }
}
